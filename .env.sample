# -------------------------------------
# ------ Paramètre postgresSQL --------
# -------------------------------------

POSTGRES_URL=postgresql://api-bal-user:password@localhost:5432/api-depot

# -------------------------------------
# --------- Autre paramètres ----------
# -------------------------------------

PORT=4242
ADMIN_TOKEN=
DEMO_MODE=1
SESSION_SECRET=foobar
# Phase 1 US launch should validate with the US profile.
API_DEPOT_VALIDATION_PROFILE=us
API_DEPOT_VALIDATION_US_DOWNGRADED_ERRORS=row.longlat_invalides
# Deprecated fallback:
# API_DEPOT_PERMISSIVE_VALIDATION=0

# -------------------------------------
# -------------- Slack ----------------
# -------------------------------------

MATTERMOST_WEBHOOK_URL=

# -------------------------------------
# ---------- Autre api url ------------
# -------------------------------------

API_DEPOT_URL=https://plateforme-bal.adresse.data.gouv.fr/api-depot
API_ANNUAIRE=https://api-lannuaire.service-public.fr/api/explore/v2.1

# -------------------------------------
# ---------- BAN paramètres -----------
# -------------------------------------

NOTIFY_BAN=1
BAN_API_URL=https://plateforme.adresse.data.gouv.fr/ban
BAN_API_TOKEN=

# -------------------------------------
# ----- France connect paramètre ------
# -------------------------------------

PC_SERVICE_URL=
PC_FS_ID=
PC_FS_SECRET=
PC_FS_CALLBACK=http://localhost:4242/habilitations/proconnect/callback

# -------------------------------------
# ------ Paramètre serveur smpt -------
# -------------------------------------

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=YES
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_BCC=

# -------------------------------------
# -------- Paramètre bucket s3 --------
# -------------------------------------

# In local US-mode development, these may stay empty and uploaded BAL files
# will fall back to database storage instead of S3.

S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net/
S3_REGION=
S3_CONTAINER_ID=
S3_USER=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_DESCRIPTION=
